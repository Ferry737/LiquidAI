{
  "name": "liquidai",
  "version": "2.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,green \"npm:dev:web\" \"npm:dev:server\"",
    "dev:web": "next dev",
    "dev:server": "npm run dev --prefix server",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "worker": "tsx worker/index.ts",
    "db:up": "docker compose up -d",
    "db:migrate": "npm run db:migrate:dev --prefix server",
    "db:generate": "npm run db:generate --prefix server"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.0",
    "@uniswap/sdk-core": "^5.8.0",
    "@uniswap/v3-sdk": "^3.13.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.6.1",
    "next": "14.2.15",
    "node-cron": "^3.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "tailwind-merge": "^2.5.4",
    "viem": "^2.21.37",
    "wagmi": "^2.12.20"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.15",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
