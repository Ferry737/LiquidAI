// server/prisma/schema.prisma
// LiquidAI persistence layer — Postgres via Prisma.
// v1.3: adds NotificationSetting + EngineState models.
// v1.4: adds PoolHourData (cached hourly pool data for backtesting) + Backtest.
// v1.6: multi-chain — chainId on PoolHourData, Backtest, StrategyAction,
//       PositionSnapshot (Position already had it); unique keys include
//       chainId. Adds PositionDailySnapshot (retention aggregation).

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Position {
  id         String   @id @default(cuid())
  chainId    Int
  tokenId    String
  owner      String
  pool       String
  pair       String   // v1.9: token pair symbol (e.g., "ETH/USDC")
  token0     String
  token1     String
  feeTier    Int
  tickLower  Int
  tickUpper  Int
  createdAt  DateTime @default(now())
  closedAt   DateTime?

  snapshots      PositionSnapshot[]
  dailySnapshots PositionDailySnapshot[]
  strategyConfig StrategyConfig?
  actions        StrategyAction[]

  @@unique([chainId, tokenId])
  @@index([owner])
  @@map("positions")
}

model PositionSnapshot {
  id               String   @id @default(cuid())
  positionId       String
  chainId          Int      @default(11155111)
  ts               DateTime @default(now())
  liquidity        String
  amount0          String
  amount1          String
  unclaimedFeesUsd Float
  valueUsd         Float
  inRange          Boolean
  ilPct            Float

  position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@index([positionId, ts])
  @@index([chainId, ts])
  @@map("position_snapshots")
}

// ---- v1.6: Daily aggregate of PositionSnapshots (retention) ----

model PositionDailySnapshot {
  id                  String   @id @default(cuid())
  positionId          String
  chainId             Int      @default(11155111)
  /// UTC midnight of the aggregated day.
  day                 DateTime
  avgValueUsd         Float
  minValueUsd         Float
  maxValueUsd         Float
  avgUnclaimedFeesUsd Float
  maxUnclaimedFeesUsd Float
  avgIlPct            Float
  /// Fraction of the day's snapshots that were in range (0..1).
  inRangeRatio        Float
  sampleCount         Int

  position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@unique([positionId, day])
  @@index([chainId, day])
  @@map("position_daily_snapshots")
}

model StrategyConfig {
  id               String   @id @default(cuid())
  positionId       String   @unique
  enabled          Boolean  @default(true)
  rebalanceAfterHrs Float   @default(6)
  compoundMinUsd   Float    @default(10)
  maxSlippagePct   Float    @default(0.5)
  stopLossIlPct    Float?
  updatedAt        DateTime @updatedAt

  position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@map("strategy_configs")
}

model StrategyAction {
  id          String   @id @default(cuid())
  positionId  String
  chainId     Int      @default(11155111)
  ts          DateTime @default(now())
  type        ActionType
  status      ActionStatus
  txHash      String?
  detailsJson String

  position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@index([positionId, ts])
  @@index([chainId, ts])
  @@map("strategy_actions")
}

enum ActionType {
  REBALANCE
  COMPOUND
  STOP_LOSS
  SKIPPED
}

enum ActionStatus {
  EXECUTED
  FAILED
  DRY_RUN
  PENDING_APPROVAL  // v1.9: awaiting human approval for mainnet trading
  APPROVED          // v1.9: approved for execution
  REJECTED          // v1.9: rejected by policy or human
}

// ---- v1.3: Telegram notification preferences ----

model NotificationSetting {
  id              String   @id @default(cuid())
  owner           String   @unique
  telegramChatId  String?
  enabled         Boolean  @default(false)
  onRebalance     Boolean  @default(true)
  onCompound      Boolean  @default(true)
  onStopLoss      Boolean  @default(true)
  onFailure       Boolean  @default(true)
  onOutOfRangeHrs Float?
  updatedAt       DateTime @updatedAt

  @@map("notification_settings")
}

// ---- v1.3: Engine state singleton (dry-run toggle, running flag) ----

model EngineState {
  id        String   @id @default("singleton")
  running   Boolean  @default(true)
  dryRun    Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@map("engine_states")
}

// ---- v1.4: Cached hourly pool data for backtesting ----

model PoolHourData {
  id        String   @id @default(cuid())
  poolId    String
  chainId   Int      @default(11155111)
  ts        DateTime
  price     Float
  tick      Int
  tvlUsd    Float
  volumeUsd Float
  feesUsd   Float

  @@unique([chainId, poolId, ts])
  @@index([chainId, poolId, ts])
  @@map("pool_hour_data")
}

// ---- v1.4: Persisted backtest results ----

model Backtest {
  id         String   @id @default(cuid())
  owner      String
  poolId     String
  chainId    Int      @default(11155111)
  from       DateTime
  to         DateTime
  paramsJson String
  resultJson String
  createdAt  DateTime @default(now())

  @@index([owner, createdAt])
  @@index([chainId, poolId])
  @@map("backtests")
}

// ---- v1.9: Mainnet trading approval policies ----

model MainnetPolicySetting {
  id                     String   @id @default(cuid())
  chainId                Int      @unique
  enabled                Boolean  @default(false)
  requireHumanApproval   Boolean  @default(true)
  maxGasUsd              Float    @default(50)
  maxDailyVolumeUsd      Float    @default(10000)
  allowedActions         String   @default("COMPOUND,REBALANCE")  // CSV
  requireLiquidityCheck  Boolean  @default(true)
  requireRangeSanity     Boolean  @default(true)
  pauseOnHighFailureRate Boolean  @default(true)
  failureRateThreshold   Float    @default(30)  // percentage
  updatedAt              DateTime @updatedAt

  @@map("mainnet_policy_settings")
}

// ---- v1.9: Emergency stop circuit breaker ----

model EmergencyStop {
  id        String   @id @default("singleton")
  active    Boolean  @default(false)
  reason    String?
  stoppedAt DateTime?
  stoppedBy String?
  updatedAt DateTime @updatedAt

  @@map("emergency_stop")
}

// ---- v1.9: Engine health metrics ----

model EngineHealth {
  id          String   @id @default(cuid())
  chainId     Int
  runId       String
  success     Boolean
  durationMs  Int
  actionCount Int
  errorCount  Int
  gasUsd      Float?
  timestamp   DateTime @default(now())

  @@index([chainId, timestamp])
  @@index([runId])
  @@map("engine_health")
}
